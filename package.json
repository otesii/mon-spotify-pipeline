{
  "name": "mon-spotify-pipeline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "tsx src/local/mon-fetcher-cli.ts",
    "fetch:dry": "tsx src/local/mon-fetcher-cli.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node20 --format=esm '--external:@aws-sdk/*' --banner:js=\"import{createRequire as __cjsCreateRequire}from'node:module';const require=__cjsCreateRequire(import.meta.url);\" --outfile=dist/lambda/index.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
